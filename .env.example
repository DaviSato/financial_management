# Firebase config (optional)
# Leave all values empty to run in local-only mode (SharedPreferences only).
# Fill in to enable cloud sync and authentication.
#
# How to get these values:
#   1. Go to console.firebase.google.com
#   2. Create a project → Add Android app (package: com.example.financial_management)
#   3. Project Settings → Your apps → SDK setup → Config
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
