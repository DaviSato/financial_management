# Firebase config (optional)
# Leave all values empty to run in local-only mode (SharedPreferences only).
# Fill in to bake a default cloud connection into the build.
#
# You can also configure this at runtime in the app (Perfil → Conectar à nuvem),
# which overrides these values. This file is just the built-in default; the
# app's own config takes precedence when set.
#
# How to get these values:
#   1. Go to console.firebase.google.com
#   2. Create a project → Add Android app (package: com.example.financial_management)
#   3. Project Settings → Your apps → SDK setup → Config
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_PROJECT_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
LOGO_DEV_TOKEN
LOGO_DEV_SECRET

# Pluggy (opcional) — credenciais da aplicacao no Dashboard da Pluggy, usadas
# com o Meu Pluggy para trazer as movimentacoes dos seus bancos.
# Tambem configuravel no app (Perfil > Bancos conectados), que sobrepoe estes.
PLUGGY_CLIENT_ID=
PLUGGY_CLIENT_SECRET=
